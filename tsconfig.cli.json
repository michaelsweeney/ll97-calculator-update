{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "strict": true,
    "skipLibCheck": true,
    "baseUrl": "./src",
    "paths": {
      "locallaw/*": ["./locallaw/*"],
      "types": ["./types.ts"]
    }
  },
  "include": ["src/shared", "src/locallaw", "cli"]
}
